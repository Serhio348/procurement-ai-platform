# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://procurement:procurement@localhost:5432/procurement

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible, MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=procurement
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Procurement sources ---
# Belarusian portals geo-block non-BY traffic. Keep "fixture" until the
# runtime actually sits on a Belarusian network, then switch to "live".
PROCUREMENT_SOURCE_MODE=fixture
GOSZAKUPKI_BY_BASE_URL=https://goszakupki.by
GOSZAKUPKI_BY_RATE_LIMIT_RPM=20
