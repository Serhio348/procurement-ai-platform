# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Specialist HTTP API (inbox + procurement cards). Vite proxies /api here.
API_PORT=3001
SPECIALIST_API_URL=http://127.0.0.1:3001
# Optional. NotificationAgent projection target when a process constructs HttpSpecialistInboxEvents.
INTERNAL_API_TOKEN=

# --- Console login ---
# First admin is created only when the user table is empty.
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me-now
# Public URL of the console. Used in password-reset links.
AUTH_PUBLIC_URL=http://127.0.0.1:5173
# 0 on HTTP. Set 1 after TLS so the session cookie is Secure.
AUTH_COOKIE_SECURE=0
# Optional. Without SMTP, login and sign-up work; password reset returns 503.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM=

# --- Database ---
# Specialist profiles, cases, and document hashes (not file bytes).
# After `npm run infra:up` run `npm run db:migrate`.
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement
POSTGRES_PORT=5432
DATABASE_URL=postgres://procurement:procurement@localhost:5432/procurement

# --- Queue ---
# Repeatable specialist discovery. If Redis is down, the API uses setInterval.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible, MinIO locally) ---
# File bytes keyed as blobs/{sha256}. PostgreSQL stores only the hash.
MINIO_ROOT_USER=procurement
MINIO_ROOT_PASSWORD=procurement-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=procurement
S3_ACCESS_KEY_ID=procurement
S3_SECRET_ACCESS_KEY=procurement-local-secret

# --- LLM provider (OpenAI-compatible, DeepSeek) ---
# Copy this file to `.env` in the repo root and paste the key there:
#   copy .env.example .env
# Get the key at https://platform.deepseek.com/api_keys
# The same key is used by Supervisor, CommercialTermsAgent, and the OCR compare script.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional. Supervisor HTTP timeout in milliseconds.
LLM_TIMEOUT_MS=45000
# Vision model for scanned pages. deepseek-chat cannot see images.
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
# Optional. Vision request timeout for `npm run compare:extractors`.
LLM_VISION_TIMEOUT_MS=120000

# --- Telegram ---
# fixture (default) records telegram.send without HTTP. live calls Bot API.
NOTIFICATION_TELEGRAM_MODE=fixture
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Procurement sources ---
# Keep fixture for deterministic development and CI. Live search from the
# specialist console (`npm run web`) and card reads require a Belarusian
# network; the adapter bootstraps an anonymous session.
PROCUREMENT_SOURCE_MODE=fixture
GOSZAKUPKI_BY_BASE_URL=https://goszakupki.by
GOSZAKUPKI_BY_RATE_LIMIT_RPM=20
GOSZAKUPKI_BY_TIMEOUT_MS=20000
# Set to 1 only if live search fails with "unable to verify the first certificate"
# (incomplete chain on some Linux CA stores). Do not use on a public host.
# GOSZAKUPKI_TLS_INSECURE=1
# Optional. The adapter uses an identifying read-only user agent by default.
# Optional. Pin capture to a known procedure instead of the first search hit.
# Example: auction/3629820
LIVE_CASE_SOURCE_ID=

# --- Documents ---
# Optional. Defaults to tests/fixtures/documents/catalog.json
DOCUMENT_FIXTURE_PATH=
# Local specialist copies keyed by sha256. Capture writes here; API serves GET /api/documents/:hash.
# MinIO remains the production store; this directory is the console copy without Docker.
DOCUMENT_BLOB_DIR=data/blobs
# Max pages to scan per contest PDF. Project albums are skipped before OCR/vision.
DOCUMENT_OCR_MAX_PAGES=20

# How often the API re-checks goszakupki.by when profile watch is on.
# Default 1 hour. Watch off: the timer still fires but discovery is a no-op.
SPECIALIST_DISCOVERY_INTERVAL_MS=3600000
