{
  "name": "@procurement/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Specialist HTTP API: inbox, procurement cards, and profile search via fixture or Procurement MCP.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@procurement/contracts": "0.1.0",
    "@procurement/db": "0.1.0",
    "@procurement/domain": "0.1.0",
    "@procurement/mcp-client": "0.1.0",
    "@procurement/mcp-documents": "0.1.0",
    "@procurement/observability": "0.1.0",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.1",
    "nodemailer": "^10.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1"
  }
}
