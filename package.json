{
  "name": "procurement-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI platform for procurement search, monitoring, document analysis and specialist notifications.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "mcp/*",
    "workers/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && npm run typecheck -w @procurement/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && npm test -w @procurement/web",
    "test:watch": "vitest",
    "arch": "depcruise packages mcp apps --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run arch",
    "clean": "tsc --build --clean",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate -w @procurement/db",
    "db:bootstrap": "npm run db:bootstrap -w @procurement/db",
    "capture:live-case": "npm run capture-case -w @procurement/mcp-procurement",
    "compare:extractors": "npm run compare-extractors -w @procurement/mcp-documents",
    "evaluate:search": "npm run evaluate-search -w @procurement/domain",
    "evaluate:search:collect": "npm run collect-eval-hits -w @procurement/mcp-procurement",
    "diagnose:site-search": "npm run diagnose-site-search -w @procurement/mcp-procurement --",
    "diagnose:posted-search": "npm run diagnose-posted-search -w @procurement/mcp-procurement --",
    "mcp:procurement": "npm run start -w @procurement/mcp-procurement",
    "mcp:documents": "npm run start -w @procurement/mcp-documents",
    "mcp:notifications": "npm run start -w @procurement/mcp-notifications",
    "dev": "npm run web",
    "web": "concurrently -k -n api,web -c blue,green \"npm run start -w @procurement/api\" \"npm run dev -w @procurement/web\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serhio348/procurement-ai-platform.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "6.3.5"
  }
}
