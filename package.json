{
  "name": "procurement-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI platform for procurement search, monitoring, document analysis and specialist notifications.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "mcp/*",
    "workers/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise packages mcp --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run arch",
    "clean": "tsc --build --clean",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate -w @procurement/db",
    "db:bootstrap": "npm run db:bootstrap -w @procurement/db",
    "mcp:procurement": "npm run start -w @procurement/mcp-procurement"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serhio348/procurement-ai-platform.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
